-- =========================
-- DROP OLD TABLES (OPTIONAL)
-- =========================

drop table if exists students cascade;
drop table if exists student_statuses cascade;
drop table if exists orders cascade;
drop table if exists japanese_levels cascade;


-- =========================
-- STUDENT STATUSES
-- =========================

create table student_statuses (
    id bigint generated always as identity primary key,
    name text not null,
    code text not null unique,
    color text,
    sort_order int default 0,
    created_at timestamptz default now()
);

insert into student_statuses (
    name,
    code,
    color,
    sort_order
)
values
('Mới đăng ký', 'NEW', '#94A3B8', 1),
('Đang học', 'STUDYING', '#3B82F6', 2),
('Chờ phỏng vấn', 'WAITING_INTERVIEW', '#F59E0B', 3),
('Đã trúng tuyển', 'PASSED', '#22C55E', 4),
('Đã xuất cảnh', 'DEPARTED', '#8B5CF6', 5);


-- =========================
-- ORDERS (ĐƠN HÀNG / NGÀNH)
-- =========================

create table orders (
    id bigint generated always as identity primary key,
    name text not null,
    country text default 'Japan',
    description text,
    is_active boolean default true,
    created_at timestamptz default now()
);

insert into orders (
    name,
    country
)
values
('Kỹ thuật CNC', 'Japan'),
('Chăm sóc người cao tuổi', 'Japan'),
('Hàn công nghiệp', 'Japan'),
('Chế biến thực phẩm', 'Japan'),
('Điện tử', 'Japan'),
('Dệt may', 'Japan'),
('Xây dựng', 'Japan'),
('Nông nghiệp', 'Japan');


-- =========================
-- JAPANESE LEVELS
-- =========================

create table japanese_levels (
    id bigint generated always as identity primary key,
    level text not null unique,
    rank int not null,
    created_at timestamptz default now()
);

insert into japanese_levels (
    level,
    rank
)
values
('N5', 1),
('N4', 2),
('N3', 3),
('N2', 4),
('N1', 5);


-- =========================
-- STUDENTS
-- =========================

create table students (
    id bigint generated always as identity primary key,

    student_code text not null unique,
    full_name text not null,

    gender text not null
        check (gender in ('male', 'female')),

    phone text,

    avatar_url text,

    order_id bigint
        references orders(id)
        on delete set null,

    status_id bigint
        references student_statuses(id)
        on delete set null,

    japanese_level_id bigint
        references japanese_levels(id)
        on delete set null,

    departure_date date,

    created_at timestamptz default now(),
    updated_at timestamptz default now()
);


